# Copie para apps/api/.env (fora do git) e ajuste.
NODE_ENV=development
PORT=3000

# Postgres local. O script scripts/setup-dev-db.ps1 cria o usuário e o banco com estes valores.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fluxo_dev
DB_USER=fluxo_app
DB_PASSWORD=troque-esta-senha
DB_MIGRATE_ON_START=true
DB_DEBUG=false
