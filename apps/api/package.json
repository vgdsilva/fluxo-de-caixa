{
  "name": "@fluxo/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do Fluxo de Caixa.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "mikro-orm": "mikro-orm",
    "db:migration:create": "mikro-orm migration:create",
    "db:migrate": "mikro-orm migration:up",
    "db:seed": "mikro-orm seeder:run",
    "db:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-dev-db.ps1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@fluxo/contracts": "workspace:*",
    "@mikro-orm/core": "^7.2.10",
    "@mikro-orm/decorators": "^7.2.10",
    "@mikro-orm/migrations": "^7.2.10",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.10",
    "@mikro-orm/seeder": "^7.2.10",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "nestjs-zod": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.10",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/database/mikro-orm.config.ts",
      "./dist/database/mikro-orm.config.js"
    ],
    "tsConfigPath": "./tsconfig.json"
  }
}
