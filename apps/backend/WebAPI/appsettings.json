{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=fluxo_de_caixa;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "WebAPI",
    "Audience": "WebAPI",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Background": {
    "Enabled": true,
    "OutboxPollingSeconds": 5,
    "OutboxBatchSize": 50,
    "WebhookPollingSeconds": 10,
    "WebhookBatchSize": 20
  },
  "Webhooks": {
    "MaxAttempts": 8,
    "BaseDelaySeconds": 30,
    "MaxDelayMinutes": 60,
    "TimeoutSeconds": 15,
    "SignatureToleranceSeconds": 300,
    "InboundSecrets": {}
  },
  "Cors": {
    "Origins": []
  }
}
