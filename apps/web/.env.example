# Copie para apps/web/.env (fora do git). Tudo aqui é opcional: sem o arquivo, valem os padrões.
# Só variáveis com prefixo VITE_ chegam ao código do navegador (import.meta.env.VITE_*).

# Para onde o servidor de desenvolvimento do Vite repassa /api (não vai para o navegador).
API_PROXY_TARGET=http://localhost:3000
