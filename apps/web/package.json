{
  "name": "@fluxo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end Vue 3 (SPA/PWA) do Fluxo de Caixa.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fluxo/contracts": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/vue": "^1.73.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
