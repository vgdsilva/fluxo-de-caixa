{
  "name": "@fluxo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Front-end Vue 3 (SPA/PWA) do Fluxo de Caixa.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fluxo/contracts": "workspace:*",
    "@primeuix/themes": "~2.0.3",
    "pinia": "^4.1.0",
    "primevue": "~4.5.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
