<?xml version="1.0" encoding="utf-8"?>
<!--
  Fontes de pacote só deste repositório. O <clear/> ignora as fontes configuradas na máquina
  (ex.: DevExpress), que com Central Package Management geram o NU1507 e quebram o build
  por causa do TreatWarningsAsErrors. O mapeamento diz que todo pacote vem do nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
