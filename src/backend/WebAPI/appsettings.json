{
  "Database": {
    "Host": "localhost",
    "Port": 5432,
    "Name": "fluxo_de_caixa",
    "Username": "fluxo"
  },
  "Jwt": {
    "Issuer": "fluxo-de-caixa",
    "Audience": "fluxo-de-caixa",
    "AccessTokenMinutes": 15
  },
  "Session": {
    "IdleTimeoutMinutes": 10080,
    "AbsoluteTimeoutDays": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Docs": {
    "Enabled": false
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Enrichers.Thread", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] (Thread {ThreadId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
