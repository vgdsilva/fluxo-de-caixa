{
  "name": "fluxo-de-caixa",
  "private": true,
  "description": "Fluxo de caixa pessoal e do casal: projeção, cartões com parcelas e chat.",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
